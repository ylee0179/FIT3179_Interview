{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiple maps comparing where six signature minerals in the collection were found across Australia. Each mineral uses its natural colour; circle size uses one shared scale.",
  "columns": 3,
  "concat": [ //use concat with 3 columns for the multiple maps//
    {
      "title": {
        "text": "Gold",
        "subtitle": "Kalgoorlie in the west, Tarcoola and Olary in the south",
        "fontSize": 16
      },
      "width": 300,
      "height": 250,
      "projection": {
        "type": "conicEqualArea",
        "parallels": [
          -18,
          -36
        ],
        "rotate": [
          -134,
          0
        ],
        "center": [
          0,
          -27.8
        ],
        "scale": 395,
        "translate": [
          150.0,
          125.0
        ]
      },
      "layer": [
        {
          "data": {
            "sphere": true
          },
          "mark": {
            "type": "geoshape",
            "fill": "#D3E1DE",
            "stroke": null,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/australia_states.topojson",
            "format": {
              "type": "topojson",
              "feature": "states"
            }
          },
          "mark": {
            "type": "geoshape",
            "fill": "#E9E4D3",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.7,
            "clip": true
          }
        },
        {
          "data": {
            "url": "data/signature_minerals.csv"
          },
          "transform": [
            {
              "filter": "datum.species == 'Gold'"
            }
          ],
          "mark": {
            "type": "circle",
            "opacity": 0.8,
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8,
            "fill": "#C9A227",
            "filled": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "specimens",
              "type": "quantitative",
              "title": "Specimens from each place",
              "scale": {
                "type": "sqrt",
                "domain": [
                  0,
                  130
                ],
                "range": [
                  8,
                  800
                ]
              },
              "legend": null
            },
            "tooltip": [
              {
                "field": "species",
                "title": "Mineral"
              },
              {
                "field": "locality",
                "title": "Place"
              },
              {
                "field": "specimens",
                "type": "quantitative",
                "title": "Specimens"
              }
            ]
          }
        }
      ]
    },
